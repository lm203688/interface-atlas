    given-names: Xing
repository-code: "https://github.com/lm203688/interface-atlas"
license: MIT
version: 1.2.0
date-released: "2026-11-21"
keywords:
  - dose reporting standard
  - neuromodulation
  - photobiomodulation
  - focused ultrasound
  - conformal prediction
  - evidence audit
references:
  - type: article
    title: "A single-cell type transcriptomics map of human tissues"
    authors:
      - family-names: Karlsson
        given-names: M.
    journal: "Science Advances"
    year: 2021
    doi: "10.1126/sciadv.abh2169"
